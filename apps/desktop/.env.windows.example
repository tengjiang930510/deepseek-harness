# Copy to .env.windows (Git ignored). Prefer instead:
#   node ./tsy-custom-plugins/scripts/ensure-desktop-package-env.mjs
# which writes the same shared non-secret values every developer on this team uses.
# Use UTF-8. Quote secrets containing # or spaces.
# Credential file paths may be absolute or relative to apps/desktop. Values are not shell-expanded.

# --- Shared team packaging (non-secret; required for unsigned / prepare) ---
DSH_DESKTOP_APP_ID=com.deepseek.harness
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DOWNLOAD_TEST_ORIGIN=https://updates.example.com
# Required for test releases: 32 lowercase hexadecimal characters.
DOWNLOAD_TEST_RELEASE_ID=0123456789abcdef0123456789abcdef

# npm registry for the bundled dsh runtime install (CN mirror).
DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com

# Mandatory-update origins (HTTPS placeholders shared by the team for local unsigned builds).
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://policy.example.com
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=https://policy.example.com
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG={"allowedAuthOrigins":["https://login.example.com"]}

# Enterprise Desktop: skip official welcome / API Key page → t4y-identity gate.
# ensure-desktop-package-env.mjs rewrites these to absolute / stage paths.
DSH_DESKTOP_TRIAL_PLUGINS_DIR=.desktop-build/trial-plugins
DSH_DESKTOP_TRIAL_DEFAULTS_FILE=

# --- Local secrets (optional; never committed) ---
DSH_DESKTOP_WINDOWS_CER_FILE=
DSH_DESKTOP_WINDOWS_SIGNTOOL=
DSH_DESKTOP_WINDOWS_KEY_CONTAINER=
DSH_DESKTOP_WINDOWS_TOKEN_PIN=

# Optional absolute, private local directory; defaults to %USERPROFILE%\.dsh-desktop-signing\signature-cache\v1.
# DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=C:\Users\build\.dsh-desktop-signing\signature-cache\v1

# Cache-hit restore and verification workers (1-8). Hardware signing remains serial.
DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4

# Optional upload configuration; packaging does not require these credentials.
# DOWNLOAD_TEST_COS_BUCKET=
# DOWNLOAD_TEST_COS_SECRET_ID=
# DOWNLOAD_TEST_COS_SECRET_KEY=
# DOWNLOAD_PROD_COS_BUCKET=
# DOWNLOAD_PROD_COS_SECRET_ID=
# DOWNLOAD_PROD_COS_SECRET_KEY=
