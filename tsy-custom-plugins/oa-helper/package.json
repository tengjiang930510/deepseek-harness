{
  "name": "oa-helper",
  "version": "0.3.3",
  "description": "武汉地铁智能助手：办公申请、请假/出差（菜单 name / 包名：oa-helper）。",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "smoke:leave": "node ./scripts/smoke-leave-open.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "playwright": "^1.64.0"
  },
  "license": "MIT"
}
