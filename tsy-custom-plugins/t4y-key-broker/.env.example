# Never expose NEW_API_ROOT_PASSWORD or this file's contents to a browser.
BROKER_LISTEN_HOST=127.0.0.1
BROKER_LISTEN_PORT=4010
# Legacy JSON path (one-shot import into SQLite when broker.db is empty).
BROKER_DATA_FILE=/var/lib/t4y-key-broker/state.json
# Primary ledger (WAL). Defaults to <dirname(BROKER_DATA_FILE)>/broker.db
# BROKER_SQLITE_PATH=/var/lib/t4y-key-broker/broker.db
EXTERNAL_API_BASE_URL=https://jgyw.crfsdi.com.cn:51111/backendapi
# Prefer host-network or a non-Docker-bridge source IP. New API login rate limits
# are keyed by client IP; traffic from 172.17.0.1 is easily exhausted in tests.
NEW_API_BASE_URL=http://127.0.0.1:4000
NEW_API_ROOT_USERNAME=replace-me
NEW_API_ROOT_PASSWORD=replace-me
# Optional: same-host New API SQLite (one-api.db). When set, issue reads token
# secrets from this file instead of POST /api/token/{id}/key (avoids 429).
# NEW_API_SQLITE_PATH=/path/to/one-api.db
# Cache getInfo by access-token digest (status polls + issue). 0 disables.
BROKER_IDENTITY_CACHE_TTL_SECONDS=45
# The upstream access token's documented maximum lifetime: 30 days.
BROKER_MAX_SESSION_SECONDS=2592000
# Refresh cached root JWT this many seconds before access_expires_at.
BROKER_ROOT_SESSION_REFRESH_SKEW_SECONDS=60
# New API has a finite User wallet. This maximum is the product's practical
# "unlimited" enterprise budget; API keys themselves use unlimited_quota=true.
BROKER_ENTERPRISE_QUOTA=9007199254740991
# Ops console at /admin. Leave empty to disable. Never put this in a browser build.
BROKER_ADMIN_TOKEN=
