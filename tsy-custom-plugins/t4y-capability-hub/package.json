{
  "name": "t4y-capability-hub",
  "version": "0.1.18",
  "description": "武汉地铁授权插件设置页：按项目菜单叶子表单管理安装、启停与最新版更新。",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "immediately": true,
      "platform": "web"
    }
  },
  "license": "MIT"
}
