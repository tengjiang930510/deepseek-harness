{
  "name": "t4y-identity",
  "version": "0.2.17",
  "description": "企业后端登录门禁：RSA 登录、nickName 展示、module 切换，并驱动租户与品牌。",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "enterprise-access.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "t4y-capability-hub"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
